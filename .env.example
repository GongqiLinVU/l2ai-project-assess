PORT=3400
MODEL_MODE=mock
# Server only. Explicit opt-in AFTER approval of estimated paid usage:
ENABLE_PAID_CALLS=false
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_MAX_OUTPUT_TOKENS=2500
# Optional verified USD per million tokens; blank means cost unknown.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=

# Local persistence (isolated project Supabase stack, ports 54341-54343).
# Direct Postgres connection used by lib/db.mjs; NOT the Supabase Data API.
# Leave blank to run without persistence (interviews stay in the browser only).
# Default local value printed by `npm run db:start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
